// These new scenes have subtitle dialogue. The original voice bank keeps its clip IDs.
CAMPAIGN_LINE(ScoutNoraRefused, "NORA MARSH", "THE SCOUT ANSWERED. THE FLAGSHIP WON'T MOVE UNTIL THE SCOUT CONFIRMS.", SubtitleOnly)
CAMPAIGN_LINE(ScoutDeltaRefused, "DELTA-1", "NORA'S SPOOF REACHED THE SCOUT. THE FLAGSHIP'S WAITING FOR THAT SHIP TO CONFIRM.", SubtitleOnly)
CAMPAIGN_LINE(ScoutDeltaCrate, "DELTA-1", "SEE THAT CRATE? IT PICKS UP ANYTHING WITH THE RIGHT TAG. YOU'VE GOT THE TAG.", SubtitleOnly)
CAMPAIGN_LINE(ScoutNoraBoard, "NORA MARSH", "I'LL KEEP THE DISH ON THEM. GET TO THE BRIDGE AND ECHO MY CALL.", SubtitleOnly)
CAMPAIGN_LINE(ScoutDeltaBoard, "DELTA-1", "I'LL RUN HER CALL FROM HERE. GET TO THE BRIDGE. GIVE THEM AN ANSWER THEY'LL BELIEVE.", SubtitleOnly)
CAMPAIGN_LINE(ScoutCargoCue, "DELTA-1", "THE CARGO CHUTES ANSWER THE SAME SIGNAL. SEND THAT CRATE LEFT. YOU GO RIGHT.", SubtitleOnly)
CAMPAIGN_LINE(ScoutBridgeCue, "DELTA-1", "THAT'S THE BRIDGE. THE WEST SADDLE IS CLEAR. KEEP THE BEAM OFF THE FLARES.", SubtitleOnly)
CAMPAIGN_LINE(ScoutReclaimCue, "DELTA-1", "IT TURNED. WAIT, THERE'S A BEAM ON YOUR SHIP. THEY'RE COMING ABOARD!", SubtitleOnly)
CAMPAIGN_LINE(ScoutClearLanding, "DUSTOFF", "THE CLEARING'S YOURS, DELTA. PUT THAT THING DOWN BY THE WALL.", SubtitleOnly)
CAMPAIGN_LINE(ScoutRoadLanding, "DUSTOFF", "THE CLEARING'S GONE. SOUTH ROAD IS OPEN. AIM FOR THE WARHORSE WRECK.", SubtitleOnly)
CAMPAIGN_LINE(ArrayDeltaJammer, "DELTA-1", "WE LOST THE LINK. EAST EAVES, JUST PAST THE ROOF. GET OUTSIDE FOR A SHOT.", SubtitleOnly)
CAMPAIGN_LINE(ArrayFleetRelay, "DELTA-1", "THE DISH CAN REACH THEM. WE NEED A LANDING CODE. TRY THE RELAY AT THE EAST BEND.", SubtitleOnly)
CAMPAIGN_LINE(ArrayWestRepeater, "DELTA-1", "GOOD COPY. LOAD THE CODE INTO OUR REPEATER ON THE WEST ROAD.", SubtitleOnly)
CAMPAIGN_LINE(ArrayConsoleBreach, "DELTA-1", "THEY SAW THE REPEATER LIGHT UP. I'VE GOT CONTACT AT THE HOUSE. GET BACK HERE.", SubtitleOnly)
CAMPAIGN_LINE(ArrayScoutSighted, "DELTA-1", "SCOUT AT THE STONE WALL. IT'S PICKING UP STRAGGLERS. HAVE A LOOK.", SubtitleOnly)
CAMPAIGN_LINE(ArrayScoutTag, "DELTA-1", "TIMBERLINE'S TAG STILL WORKS. STEP INTO THE BEAM AND HOLD SIGNAL.", SubtitleOnly)
CAMPAIGN_LINE(ArrayNoraBoard, "NORA MARSH", "THE SCOUT KNOWS WHERE THEY CAME FROM. BRING IT BACK IN ONE PIECE, DELTA.", SubtitleOnly)
CAMPAIGN_LINE(ArrayDeltaBoard, "DELTA-1", "GET THAT SCOUT DOWN IN ONE PIECE, DELTA. WE NEED ITS FLIGHT LOGS.", SubtitleOnly)
CAMPAIGN_LINE(ArrayBridge, "DELTA-1", "FLAGSHIP'S DOWN BEHIND THE RIDGE. GET TO THE HELM. LET'S BRING HER HOME.", SubtitleOnly)
CAMPAIGN_LINE(ArrayAutoReturn, "DELTA-1", "IT'S TAKING YOU TO THE FLAGSHIP. CUT THE RETURN LINK AT THE CHUTE'S WINCH.", SubtitleOnly)
CAMPAIGN_LINE(ArrayManual, "DELTA-1", "THE LINK'S GONE. BACK TO THE HELM. SHE'S YOURS IF YOU CAN GET HER DOWN.", SubtitleOnly)
CAMPAIGN_LINE(NoraGuardPulse, "NORA MARSH", "WATCH THE DISH. EVERY PULSE OPENS THAT ENFORCER'S GUARD.", SubtitleOnly)
